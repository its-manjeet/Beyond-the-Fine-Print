# Copy to .env (never commit .env) and fill in your key.

# --- LLM ---
# Which provider implementation to use: anthropic | groq (see backend/app/core/llm/factory.py).
LLM_PROVIDER=anthropic
# Retries (all providers) with exponential backoff on rate limits / overload / 5xx / network errors.
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=30
LLM_TIMEOUT_SECONDS=120

# --- Anthropic (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Re-run a refused request on Anthropic's recommended fallback model (Claude API only).
LLM_SERVER_FALLBACK=true

# --- Groq (LLM_PROVIDER=groq) ---
GROQ_API_KEY=
# Text model; must support strict structured outputs (openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b).
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Only qwen/qwen3.8-27b accepts images on Groq. Leave empty to reject image requests.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Per-agent text model override (JSON). Agents not listed use GROQ_TEXT_MODEL.
# The small model handles classification and key facts and has its own free-tier budget.
GROQ_AGENT_MODELS={"classifier": "openai/gpt-oss-20b", "key_facts": "openai/gpt-oss-20b"}
# Completion tokens requested per call (counts toward the free-tier 8K tokens/minute).
GROQ_MAX_OUTPUT_TOKENS=2048
# Reasoning effort for gpt-oss models: low | medium | high (empty = Groq's default).
# Reasoning tokens count toward GROQ_MAX_OUTPUT_TOKENS; "low" leaves room for the answer.
GROQ_REASONING_EFFORT=low
# Client-side rate limiter. RPM isn't in the response headers; TPM and RPD are read from them.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_MAX_LIMITER_WAIT_SECONDS=90
# Limits were confirmed per model on 2026-10-02; set "shared" if Groq changes that.
GROQ_RATE_LIMIT_SCOPE=model

# --- Documents ---
# SQLite file by default (data/app.db, gitignored). Any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///C:/path/to/app.db
# Uploaded documents and everything derived from them are deleted after this many hours.
RETENTION_HOURS=24
MAX_UPLOAD_MB=25
MAX_PAGES=20
# Below this classifier confidence, the user is asked to confirm the document type.
CLASSIFIER_MIN_CONFIDENCE=0.6
# Risk score weights: clause type, risk patterns, legality, money at stake.
RISK_WEIGHTS=[0.30, 0.50, 0.10, 0.10]
# Tesseract is an optional OCR fallback, used only if this command is on PATH.
TESSERACT_CMD=tesseract

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# json (default, for machines) or console (readable in a terminal)
LOG_FORMAT=json
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
